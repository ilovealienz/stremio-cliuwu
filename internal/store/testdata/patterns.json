  "expand(\"{title}\",map[title:Inception year:])=[\"Inception\"]",
  "expand(\"{title}\",map[episode:02 season:01 show:Show: Name title:Pilot year:2001])=[\"Pilot\"]",
  "expand(\"{title}\",map[episode:02 season:01 show: title: year:])=[]",
