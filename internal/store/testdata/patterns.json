  "expand(\"{show}/Season {season}/{episode} {title}\",map[title:Inception year:2010])=[\"{show}\" \"Season {season}\" \"{episode} Inception\"]",
  "expand(\"{show}/Season {season}/{episode} {title}\",map[title:Inception year:])=[\"{show}\" \"Season {season}\" \"{episode} Inception\"]",
  "expand(\"{show}/Season {season}/{episode} {title}\",map[episode:02 season:01 show:Show: Name title:Pilot year:2001])=[\"Show- Name\" \"Season 01\" \"02 Pilot\"]",
  "expand(\"{show}/Season {season}/{episode} {title}\",map[episode:02 season:01 show: title: year:])=[\"Season 01\" \"02\"]",
  "expand(\"A\\\\B/{title}\",map[title:Inception year:2010])=[\"A\" \"B\" \"Inception\"]",
  "expand(\"A\\\\B/{title}\",map[title:Inception year:])=[\"A\" \"B\" \"Inception\"]",
  "expand(\"A\\\\B/{title}\",map[episode:02 season:01 show:Show: Name title:Pilot year:2001])=[\"A\" \"B\" \"Pilot\"]",
  "expand(\"A\\\\B/{title}\",map[episode:02 season:01 show: title: year:])=[\"A\" \"B\"]",
